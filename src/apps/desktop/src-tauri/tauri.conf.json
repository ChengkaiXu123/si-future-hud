{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SI Future HUD",
  "version": "0.1.4",
  "identifier": "com.agenthud.next.preview",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node ../../tooling/package-resources.mjs && pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "SI Future HUD — Settings",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "width": 960,
        "height": 720,
        "minWidth": 880,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "resources/": "./"
    }
  }
}
